def ensure_n8n_environment(path: Path = N8N_ENVIRONMENT) -> Path:
    return ensure_private_environment(
        path,
        {
            "DB_TYPE": "postgresdb",
            "DB_POSTGRESDB_DATABASE": "n8n",
            "DB_POSTGRESDB_HOST": "postgres",
            "DB_POSTGRESDB_PORT": "5432",
            "DB_POSTGRESDB_USER": "etl",
            "DB_POSTGRESDB_PASSWORD": "etl-local",
            "DB_POSTGRESDB_SCHEMA": "public",
            "N8N_ENCRYPTION_KEY": secrets.token_hex(32),
            "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS": "true",
            "N8N_RUNNERS_ENABLED": "true",
            "N8N_DIAGNOSTICS_ENABLED": "false",
            "N8N_VERSION_NOTIFICATIONS_ENABLED": "false",
            "N8N_PERSONALIZATION_ENABLED": "false",
            "N8N_BLOCK_ENV_ACCESS_IN_NODE": "true",
            "N8N_EDITOR_BASE_URL": "http://localhost:18083",
            "WEBHOOK_URL": "http://localhost:18083/",
            "GENERIC_TIMEZONE": "UTC",
            "TZ": "UTC",
        },
    )


def main() -> None:
    args = parse_args()
    if args.ssh_key and args.git_connection:
        raise SystemExit("use either --ssh-key or --git-connection, not both")
    if args.repository and args.bundle_manifest:
        raise SystemExit("use either one repository or --bundle-manifest, not both")
    if not args.repository and not args.bundle_manifest:
        raise SystemExit("provide one repository or --bundle-manifest")
    if args.bundle_manifest and args.git_connection:
        raise SystemExit("--git-connection is only available for the single-repository mode")
    if args.external_db and not os.environ.get("AIRFLOW_METADATA_DATABASE_URL"):
        raise SystemExit(
            "--external-db requires AIRFLOW_METADATA_DATABASE_URL "
            "for the Airflow metadata database"
        )
    if args.llm_observability and (args.external_db or args.external_objects):
        raise SystemExit(
            "--llm-observability currently requires local PostgreSQL and object storage"
        )
    if args.automation and args.external_db:
        raise SystemExit("--automation currently requires local PostgreSQL")

    pipeline_env = existing_file(args.env, "pipeline environment file") if args.env else None
    ssh_key = existing_file(args.ssh_key, "SSH key") if args.ssh_key else None
    known_hosts = existing_file(args.known_hosts, "known_hosts file") if ssh_key else None

    runtime_lines: list[str]
    if args.bundle_manifest:
        manifest = existing_file(args.bundle_manifest, "bundle manifest")
        if not args.image:
            raise SystemExit("--bundle-manifest requires --image with every source package installed")
        image = args.image
        bundles = bundle_manifest(manifest)
        runtime_lines = [runtime_connection_line(bundle, ssh_key) for bundle in bundles]
    else:
        assert args.repository is not None
        connection_id = args.git_connection or "workbench_git"
        bundles = [
            DagBundle(
                name="pipeline",
                repository=args.repository,
                ref=args.ref,
                subdir=args.subdir,
                git_connection=connection_id,
            )
        ]
        image = args.image
        if not image:
            run(["docker", "build", "-t", BASE_IMAGE, "."])
            digest = hashlib.sha256(f"{args.repository}\0{args.ref}".encode()).hexdigest()[:12]
            image = f"etl-pipeline:{digest}"
            command = [
                "docker",
                "build",
                "-t",
                image,
                "--build-arg",
                f"ETL_WORKBENCH_IMAGE={BASE_IMAGE}",
                "-f",
                "Dockerfile.airflow",
            ]
            if ssh_key:
                command.extend(["--ssh", f"default={ssh_key}"])
            command.append(f"{args.repository}#{args.ref}")
            run(command)
        runtime_lines = []
        if not args.git_connection:
            runtime_lines.append(runtime_connection_line(bundles[0], ssh_key))

    compose_files = ["-f", "compose.yaml"]
    compose_env = os.environ.copy()

    if ssh_key:
        compose_files.extend(["-f", "compose.git-ssh.yaml"])
        compose_env["GIT_KNOWN_HOSTS_PATH"] = str(known_hosts)
    if args.llm_observability:
        compose_files.extend(["-f", "compose.langfuse.yaml"])
        compose_env["LANGFUSE_ENV_FILE"] = str(ensure_langfuse_environment())
    if args.automation:
        compose_files.extend(["-f", "compose.n8n.yaml"])
        compose_env["N8N_ENV_FILE"] = str(ensure_n8n_environment())

    runtime_lines.append(
        "AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST="
        + bundle_config(bundles)
    )
    STATE.mkdir(exist_ok=True)
    runtime_env = STATE / "runtime.env"
    runtime_env.write_text("\n".join(runtime_lines) + "\n")
    runtime_env.chmod(0o600)

    compose_env["AIRFLOW_IMAGE"] = image
    compose_env["WORKBENCH_ENV_FILE"] = str(runtime_env)
    if pipeline_env:
        compose_env["PIPELINE_ENV_FILE"] = str(pipeline_env)

    command = ["docker", "compose", *compose_files]
    if not args.external_db:
        command.extend(["--profile", "local-db"])
    if not args.external_objects:
        command.extend(["--profile", "local-objects"])
    if args.analytics:
        command.extend(["--profile", "analytics"])
    if args.inference_gpu:
        command.extend(["--profile", "inference-gpu"])
    if args.automation:
        command.extend(["--profile", "automation"])
    if args.observability or args.llm_observability:
        compose_env["AIRFLOW_OTEL_ENABLED"] = "true"
        command.extend(["--profile", "observability"])
    if args.llm_observability:
        command.extend(["--profile", "llm-observability"])
    if not args.external_db:
        run([*command, "stop", "airflow"], env=compose_env)
    command.extend(["up", "-d", "--wait"])
    run(command, env=compose_env)
    print("Airflow: http://127.0.0.1:18080", flush=True)
    print("DAG bundles: " + ", ".join(bundle.name for bundle in bundles), flush=True)
    if args.analytics:
        clickhouse_http_port = compose_env.get("CLICKHOUSE_HTTP_PORT", "18123")
        print(
            f"ClickHouse HTTP: http://127.0.0.1:{clickhouse_http_port}",
            flush=True,
        )
    if args.inference_gpu:
        vllm_http_port = compose_env.get("VLLM_HTTP_PORT", "18000")
        print(f"vLLM API: http://127.0.0.1:{vllm_http_port}/v1", flush=True)
        print(
            "vLLM model: "
            + compose_env.get("VLLM_SERVED_MODEL_NAME", "local-model"),
            flush=True,
        )
    if args.automation:
        n8n_ui_port = compose_env.get("N8N_UI_PORT", "18083")
        print(f"n8n: http://127.0.0.1:{n8n_ui_port}", flush=True)
    if args.observability or args.llm_observability:
        clickstack_ui_port = compose_env.get("CLICKSTACK_UI_PORT", "18081")
        print(f"ClickStack: http://127.0.0.1:{clickstack_ui_port}", flush=True)
    if args.llm_observability:
        langfuse_ui_port = compose_env.get("LANGFUSE_UI_PORT", "18082")
        print(f"Langfuse: http://127.0.0.1:{langfuse_ui_port}", flush=True)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode) from error
