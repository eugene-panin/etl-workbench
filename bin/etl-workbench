                "postgresql://etl:etl-local@postgres:5432/postgres"
            ),
            "LANGFUSE_POSTGRES_DATABASE": "langfuse",
            "SALT": secrets.token_hex(32),
            "ENCRYPTION_KEY": secrets.token_hex(32),
